<Window x:Class="WatchedFilmsTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:WatchedFilmsTracker.Source.Converters"
        xmlns:views="clr-namespace:WatchedFilmsTracker.Source.Views"
        Title="{Binding ProgramName}"
        KeyDown="Window_KeyDown"
        MinHeight="225"
        MinWidth="1150"
        ScrollViewer.CanContentScroll="True"
        Height="600">

    <Window.Resources>
        <converters:DataTypeComparisonConverter x:Key="DataTypeComparisonConverter" />

        <DataTemplate x:Key="ColumnItemTemplate">
            <StackPanel Orientation="Vertical"
                        Margin="3">

                <!-- First line: Column Header (current type) -->
                <Label Margin="0"
                       Padding="0">
                    <WrapPanel>
                        <TextBlock Text="{Binding DataGridTextColumn.Header}"
                                   FontWeight="Bold" />
                        <TextBlock Text=" (" />
                        <TextBlock Text="{Binding DataType}"
                                   FontStyle="Italic" />
                        <TextBlock Text=")" />
                    </WrapPanel>
                </Label>

                <!-- Second line: List all data types -->
                <ItemsControl ItemsSource="{Binding DataGridManager.AllDataTypes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding}"
                                         GroupName="{Binding DataContext.UniqueId, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                         Checked="RadioButton_Checked">
                                <RadioButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource DataTypeComparisonConverter}"
                                                  Mode="OneWay">
                                        <Binding Path="DataContext.SelectedDataType"
                                                 RelativeSource="{RelativeSource AncestorType=StackPanel}" />
                                        <Binding Path="." />
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource DataTypeComparisonConverter}">
                                                        <Binding Path="DataContext.DataType"
                                                                 RelativeSource="{RelativeSource AncestorType=StackPanel}" />
                                                        <Binding Path="." />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Background"
                                                        Value="#FF7D7D7D" />
                                                <Setter Property="FontWeight"
                                                        Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>

        <!-- Upper panel for all data-->
        <DockPanel DockPanel.Dock="Top"
                   LastChildFill="True">

            <!--Right Panel, Statistics and settings-->
            <ScrollViewer x:Name="RightSidebar" DockPanel.Dock="Right" Width="340"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Stretch" ClipToBounds="True"
                          Margin="0,0,0,30">
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Stretch"
                            Background="White">
                    <StackPanel.Resources>
                        <Style TargetType="Expander">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </StackPanel.Resources>

                    <!--File information-->
                    <Expander x:Name="FileInformationExpander" Header="File information"
                              Expanded="SidebarPanelExpansionChanged" Collapsed="SidebarPanelExpansionChanged">
                        <GroupBox Background="#33FF0000">

                            <GroupBox.Header>File information</GroupBox.Header>
                            <StackPanel x:Name="FileInformationBody" IsEnabled="False">
                                <StackPanel Orientation="Vertical">

                                    <GroupBox>
                                        <GroupBox.Header>File path</GroupBox.Header>
                                        <TextBox x:Name="TextBoxFilePath"
                                                 VerticalAlignment="Center"
                                                 TextWrapping="Wrap"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 IsReadOnly="True"
                                                 HorizontalAlignment="Stretch" />
                                    </GroupBox>
                                </StackPanel>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Delimiter:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <ComboBox x:Name="DelimiterComboBox" Grid.Column="1"
                                              MinWidth="0" DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value"
                                              SelectionChanged="DelimiterComboBox_SelectionChanged"
                                              ToolTip="Delimiter used when saving this collection." />
                                    <TextBlock Grid.Column="2" Text="Collection type:" Margin="8,0,4,0"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="ButtonCurrentFileCollectionType" Grid.Column="3"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            Click="ButtonCurrentFileCollectionType_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image x:Name="ImageCurrentFileCollectionType"
                                                   Source="/Assets/TabIcons/other.png"
                                                   Stretch="None"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                   RenderOptions.EdgeMode="Aliased">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.5" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock x:Name="TextBlockCurrentFileCollectionType" Grid.Column="1"
                                                       Text="Other"
                                                       Margin="3,0,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </Grid>
                                <StackPanel DataContext="{Binding DataContext, ElementName=CollectionStatisticsPanel}"
                                            Margin="4,8,4,4">
                                    <CheckBox x:Name="UseJsonCompanionCheckBox"
                                              IsChecked="{Binding IsJsonEnabled, Mode=OneWay}"
                                              Click="UseJsonCompanionCheckBox_Click"
                                              ToolTip="Store metadata, statistics and refresh preferences in a JSON companion beside the collection.">
                                        <TextBlock Text="Use JSON companion file" />
                                    </CheckBox>
                                    <TextBlock Margin="20,3,0,5" FontSize="11" Foreground="DimGray" TextWrapping="Wrap"
                                               Text="For new collections, the JSON companion will be created beside the CSV when you save. For saved collections, enabling creates it immediately." />
                                    <GroupBox Header="JSON companion path">
                                        <TextBox x:Name="TextBoxCompanionPath" IsReadOnly="True"
                                                 Text="{Binding MetadataPath, Mode=OneWay}"
                                                 VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                 TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled"
                                                 ToolTip="Select this path to copy it." />
                                    </GroupBox>
                                    <TextBlock Text="{Binding MetadataStatus}" FontSize="11"
                                               Foreground="DimGray" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </Expander>

                    <!--Settings border-->
                    <Expander x:Name="SettingsExpander" IsExpanded="True"
                              Expanded="SidebarPanelExpansionChanged" Collapsed="SidebarPanelExpansionChanged"
                              Header="Settings">
                        <GroupBox Background="#330010FF">
                            <GroupBox.Header>Settings</GroupBox.Header>
                            <StackPanel Orientation="Vertical">
                                <GroupBox>
                                    <GroupBox.Header>General</GroupBox.Header>
                                    <StackPanel Orientation="Vertical">
                                        <CheckBox x:Name="defaultDateBox"
                                                  Click="CheckBoxDefaultDate">
                                            <TextBlock Text="Default date is today" />
                                        </CheckBox>
                                        <CheckBox x:Name="autosaveBox"
                                                  ToolTip="Save changes automatically when closing an individual tab. Exiting the application asks about each file with unsaved changes."
                                                  Click="CheckBoxAutoSave"
                                                  IsChecked="False">
                                            <TextBlock Text="Autosave when closing a tab" />
                                        </CheckBox>
                                        <GroupBox Header="Use JSON for new files" Margin="0,6,0,0">
                                            <StackPanel>
                                                <WrapPanel Margin="3">
                                                    <RadioButton x:Name="JsonForNewFilesYesRadioButton" Content="Yes"
                                                                 GroupName="JsonForNewFiles" Margin="0,0,14,0"
                                                                 Click="JsonForNewFilesPreference_Click" />
                                                    <RadioButton x:Name="JsonForNewFilesNoRadioButton" Content="No"
                                                                 GroupName="JsonForNewFiles" Margin="0,0,14,0"
                                                                 Click="JsonForNewFilesPreference_Click" />
                                                    <RadioButton x:Name="JsonForNewFilesAskRadioButton" Content="Ask each time"
                                                                 GroupName="JsonForNewFiles"
                                                                 Click="JsonForNewFilesPreference_Click" />
                                                </WrapPanel>
                                                <TextBlock Margin="3,0,3,3" FontSize="11" Foreground="DimGray"
                                                           Text="The companion is created beside the CSV when the new file is saved." />
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox>
                                    <GroupBox.Header>On startup</GroupBox.Header>
                                    <StackPanel Orientation="Vertical">
                                        <CheckBox x:Name="checkboxScrollLastPosition"
                                                  Click="CheckBoxLastFilmPosition">
                                            <TextBlock Text="Scroll to the bottom of list" />
                                        </CheckBox>
                                        <CheckBox x:Name="checkboxCheckForUpdatesStartup"
                                                  Click="CheckBoxUpdateStartup">
                                            <TextBlock Text="Check for updates" />
                                        </CheckBox>
                                        <CheckBox x:Name="checkboxReopenLastFiles"
                                                  ToolTip="Reopen the saved files from your previous session. New collections are included after you save them."
                                                  Click="CheckBoxReopenFilesLastSession">
                                            <TextBlock Text="Restore previous session on startup" TextWrapping="Wrap" />
                                        </CheckBox>
                                    </StackPanel>
                                </GroupBox>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Columns order and width"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                    <Button Content="Reset to default"
                                            Grid.Column="1" Margin="6,0,0,0"
                                            HorizontalAlignment="Right"
                                            Click="ResetColumnsWidthAndOrder"
                                            VerticalAlignment="Center" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <DockPanel>
                                        <Image x:Name="ImageNewVersionSettings"
                                               Source="\Assets\ButtonIcons\newVersion.png"
                                               Stretch="None"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               RenderOptions.EdgeMode="Aliased"
                                               Margin="0,0,5,0"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Grid.RowSpan="1"
                                               Grid.ColumnSpan="1"
                                               Visibility="Collapsed" />
                                        <TextBlock x:Name="SettingsUpdateBlock"
                                                   Text="Program update"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </DockPanel>
                                    <Button x:Name="CheckUpdatesButton"
                                            Content="Check for updates"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Click="ManualCheckForUpdate"
                                            Grid.Column="1" Margin="6,0,0,0"
                                            Grid.ColumnSpan="1"
                                            Grid.RowSpan="1" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </Expander>

                    <!--Table Structure-->
                    <Expander x:Name="TableStructureExpander" IsExpanded="True"
                              Expanded="SidebarPanelExpansionChanged" Collapsed="SidebarPanelExpansionChanged"
                              Header="Table Structure">
                        <GroupBox Background="#337200FF">
                            <GroupBox.Header>Table structure</GroupBox.Header>
                            <StackPanel x:Name="TableStructureBody" IsEnabled="False">
                                <Label Content="List of columns and data types" />
                                <ItemsControl x:Name="ItemsColumnsDataTypes"
                                              ItemsSource="{Binding ColumnsAndDataTypes}"
                                              ItemTemplate="{StaticResource ColumnItemTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Button Click="DEBUG_PrintColumnTypes"
                                        Background="#FF37DDDD"><TextBlock Text="DEBUG print columns and data types" /></Button>
                                <Button Click="DEBUG_MakeAllColumnsText"
                                        Background="#FF37DDDD">DEBUG make all columns text</Button>
                                <Button Click="DEBUG_PrintCellsDataTypes"
                                        Background="#FF37DDDD">DEBUG print cells data types</Button>
                                <Button Click="ApplyChangesClick">Apply changes</Button>
                                <Button Background="#FFDD37DD"><TextBlock Text="NOT WORKING Apply z-index of columns" /></Button>
                                <Button Background="#FFDD37DD"><TextBlock Text="NOT WORKING Apply order of columns" /></Button>
                            </StackPanel>
                        </GroupBox>
                    </Expander>

                    <Expander x:Name="CollectionStatisticsExpander" Header="Collection statistics" IsExpanded="True"
                              Expanded="SidebarPanelExpansionChanged" Collapsed="SidebarPanelExpansionChanged">
                        <views:StatisticsPanel x:Name="CollectionStatisticsPanel" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- Left Panel, buttons and films grid-->
            <DockPanel LastChildFill="True"
                       DockPanel.Dock="Left">
                <StackPanel x:Name="leftPanel"
                            DockPanel.Dock="Top"
                            Orientation="Vertical"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">

                    <!--File actions border-->
                    <GroupBox x:Name="groupBoxFileActions"
                              HorizontalAlignment="Left">
                        <GroupBox.Header>File actions</GroupBox.Header>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top">
                            <Button x:Name="ButtonNewFile"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    UseLayoutRounding="False"
                                    Click="ButtonNewFile_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/ButtonIcons/newFile.png"
                                           Stretch="None"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           RenderOptions.EdgeMode="Aliased" />
                                    <TextBlock Text="New file"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="buttonOpenFile"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    UseLayoutRounding="False"
                                    Click="OpenFileButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="\Assets\ButtonIcons\openFile.png"
                                           Stretch="None"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           RenderOptions.EdgeMode="Aliased" />
                                    <TextBlock Text="Open file"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="buttonOpenContainingFolder"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    UseLayoutRounding="False"
                                    Click="OpenContainingFolder">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/ButtonIcons/openContainingFolder.png"
                                           Stretch="None"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           RenderOptions.EdgeMode="Aliased" />
                                    <TextBlock Text="Open containing folder"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                            <Button x:Name="buttonOpenLocally"
                                    VerticalAlignment="Top"
                                    Click="ButtonOpenFileLocally_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/ButtonIcons/loadLocally.png"
                                           Stretch="None"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           RenderOptions.EdgeMode="Aliased" />
                                    <TextBlock Text="Open locally"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="buttonOpenLocalFolder"
                                    VerticalAlignment="Top"
                                    Click="OpenLocalFolderButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/ButtonIcons/openLocalFolder.png"
                                           Stretch="None"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           RenderOptions.EdgeMode="Aliased" />
                                    <TextBlock Text="Open local folder"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="buttonSaveLocally"
                                    VerticalAlignment="Top"
                                    Click="SaveLocally">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/ButtonIcons/saveLocally.png"
                                           Stretch="None"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           RenderOptions.EdgeMode="Aliased" />
                                    <TextBlock Text="Save locally"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                            <Button x:Name="buttonSave"
                                    VerticalAlignment="Top"
                                    Click="SaveButtonAction">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/ButtonIcons/save2.png"
                                           Stretch="None"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           RenderOptions.EdgeMode="Aliased" />
                                    <TextBlock Text="Save"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="buttonSaveAll"
                                    VerticalAlignment="Top"
                                    Click="SaveAllButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/ButtonIcons/saveAll.png"
                                           Stretch="None"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           RenderOptions.EdgeMode="Aliased" />
                                    <TextBlock Text="Save all"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="buttonSaveAs"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    UseLayoutRounding="False"
                                    Click="SaveAs">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="\Assets\ButtonIcons\saveas2.png"
                                           Stretch="None"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           RenderOptions.EdgeMode="Aliased" />
                                    <TextBlock Text="Save as"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="buttonRevertChanges"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    UseLayoutRounding="False"
                                    Click="RevertChangesButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="\Assets\ButtonIcons\revert.png"
                                           Stretch="None"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           RenderOptions.EdgeMode="Aliased" />
                                    <TextBlock Text="Revert changes"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                            <Button x:Name="buttonAbout"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Click="AboutButton">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="\Assets\ButtonIcons\about2.png"
                                           Stretch="None"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           RenderOptions.EdgeMode="Aliased" />
                                    <TextBlock Text="About"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Check for updates" />
                                        <MenuItem Header="Open GitHub page" />
                                        <MenuItem Header="Open project page" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </GroupBox>

                    <!--Quick actions border-->
                    <DockPanel>
                        <GroupBox x:Name="groupBoxQuickActions"
                                  HorizontalAlignment="Left">
                            <GroupBox.Header>Table rows</GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="buttonAddRecord"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        UseLayoutRounding="False"
                                        Click="ButtonAddRecord_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="\Assets\ButtonIcons\addrecord.png"
                                               Stretch="None"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               RenderOptions.EdgeMode="Aliased" />
                                        <TextBlock Text="Add record"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="buttonDeleteFilmRecord"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        UseLayoutRounding="False"
                                        Click="ButtonDeleteRecord_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="\Assets\ButtonIcons\deleterecord.png"
                                               Stretch="None"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               RenderOptions.EdgeMode="Aliased" />
                                        <TextBlock Text="Delete record"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="buttonClearAll"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        UseLayoutRounding="False"
                                        Click="ClearAll">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="\Assets\ButtonIcons\clear2.png"
                                               Stretch="None"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               RenderOptions.EdgeMode="Aliased" />
                                        <TextBlock Text="Clear all"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                                <Button x:Name="buttonSelectLast"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Click="SelectLastButton">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/ButtonIcons/selectLast2.png"
                                               Stretch="None"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               RenderOptions.EdgeMode="Aliased" />
                                        <TextBlock Text="Go to last"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox>
                            <GroupBox.Header>Table columns</GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="buttonAddColumn"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Click="ButtonAddColumn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/ButtonIcons/addColumn.png"
                                               Stretch="None"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               RenderOptions.EdgeMode="Aliased" />
                                        <TextBlock Text="Add column"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="buttoRemoveColumn"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Click="RemoveColumnButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/ButtonIcons/removeColumn.png"
                                               Stretch="None"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               RenderOptions.EdgeMode="Aliased" />
                                        <TextBlock Text="Remove column"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="buttoRenameColumn"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Click="RenameColumnButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/ButtonIcons/renameColumn.png"
                                               Stretch="None"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               RenderOptions.EdgeMode="Aliased" />
                                        <TextBlock Text="Rename column"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </GroupBox>

                        <!--Search border-->
                        <GroupBox HorizontalAlignment="Right">
                            <GroupBox.Header>Search</GroupBox.Header>
                            <StackPanel HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Image Source="/Assets/ButtonIcons/search.png"
                                       Stretch="None"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       RenderOptions.EdgeMode="Aliased"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0" />

                                <Grid Width="200" VerticalAlignment="Center">
                                    <TextBox x:Name="searchTextBox"
                                             FontFamily="Segoe UI"
                                             BorderThickness="0"
                                             TextChanged="SearchTextBox_TextChanged" />
                                    <TextBlock x:Name="SearchPlaceholderText" Text="Search collection data"
                                               IsHitTestVisible="False" Foreground="Gray" FontStyle="Italic"
                                               Margin="2,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Text, ElementName=searchTextBox}" Value="" />
                                                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=searchTextBox}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button x:Name="clearSearchButton"
                                        Visibility="Hidden"
                                        BorderThickness="0,0,0,0"
                                        Background="{x:Null}"
                                        Click="searchClearButton_ClearText">
                                    <Image Source="/Assets/ButtonIcons/x.png"
                                           Stretch="None"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           RenderOptions.EdgeMode="Aliased" />
                                </Button>
                            </StackPanel>
                        </GroupBox>
                    </DockPanel>
                </StackPanel>

                <!--Watched films table border-->
                <GroupBox x:Name="groupBoxFilmList"
                          DockPanel.Dock="Left"
                          MaxWidth="{Binding Width, ElementName=groupBoxQuickActions}"
                          Margin="0,0,0,30">
                    <GroupBox.Header>Collection data</GroupBox.Header>
                    <TabControl x:Name="TabControlMainWindow">
                    </TabControl>
                </GroupBox>
            </DockPanel>
        </DockPanel>

        <!--Version bottom panel-->
        <DockPanel Background="#FFAFAFAF"
                   DockPanel.Dock="Bottom"
                   VerticalAlignment="Bottom">
            <StackPanel x:Name="PanelVersion"
                        Orientation="Horizontal"
                        DockPanel.Dock="Left"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                <Label x:Name="LabelVersion"
                       Content="{Binding ProgramVersion}" />
                <Image x:Name="ImageNewVersion"
                       Source="\Assets\ButtonIcons\newVersion.png"
                       Stretch="None"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       RenderOptions.EdgeMode="Aliased"
                       Visibility="Collapsed"
                       Margin="0,0,5,0" />
                <TextBlock x:Name="TextBlockNewVersion"
                           Visibility="Collapsed"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"></TextBlock>
            </StackPanel>
            <Label x:Name="LabelAuthor"
                   DockPanel.Dock="Right"
                   Content="{Binding ProgramCopyright}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
