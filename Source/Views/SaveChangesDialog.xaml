<Window x:Class="WatchedFilmsTracker.Source.Views.SaveChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Save changes?" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow" ShowInTaskbar="False">
    <Grid Margin="15,15,15,15">
        <StackPanel Orientation="Vertical">
            <GroupBox>
                <GroupBox.Header>Save changes?</GroupBox.Header>
                <StackPanel>
                    <DockPanel>
                        <Image Source="/Assets/DialogIcons/saveChanges.png" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" RenderOptions.EdgeMode="Aliased" Margin="10,10,10,10" HorizontalAlignment="Right" VerticalAlignment="Center" />

                        <TextBlock Text="Save changes to this collection before closing?" TextWrapping="Wrap"
                                   Margin="0,10,10,10" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="CollectionPathText" TextWrapping="Wrap" Margin="10,0,10,10" />
                </StackPanel>
            </GroupBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button x:Name="SaveButton" Content="Save" Width="100" IsDefault="True" Margin="0 0 10 0" Click="YesButton_Click" />
                <Button x:Name="DiscardButton" Content="Don't save" Width="100" Margin="0 0 10 0" Click="NoButton_Click" />
                <Button x:Name="CancelButton" Content="Cancel" Width="100" IsCancel="True" Click="CancelButton_Click" />
            </StackPanel>
        </StackPanel>
       
      
    </Grid>
</Window>
